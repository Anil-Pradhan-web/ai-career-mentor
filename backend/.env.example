# =============================================================================
# AI Career Mentor — Environment Configuration Example
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

APP_ENV=development

# --- DATABASE SETTINGS ---
# Production: Use PostgreSQL (e.g., Neon, Supabase, AWS RDS)
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Local Development: SQLite (default)
DATABASE_URL=sqlite:///./dev.db

# =============================================================================
# LLM PROVIDER CONFIGURATION
# Available providers: groq, openrouter
# =============================================================================

# --- GLOBAL DEFAULTS (used when no per-agent override exists) ---
LLM_PROVIDER=groq

# --- GROQ (High-speed streaming & cheap reasoning) ---
# Get key from: https://console.groq.com
GROQ_API_KEY=your_groq_key_here
GROQ_MODEL=openai/gpt-oss-120b

# --- OPENROUTER (Configurable LLM & Remote Embeddings) ---
# Get key from: https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_MODEL=openrouter/free
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# =============================================================================
# PER-AGENT LLM MODEL MAPPING (OPTIONAL OVERRIDES)
# Format: AGENT_<NAME>_PROVIDER=<provider>
#         AGENT_<NAME>_MODEL=<model>
#         AGENT_<NAME>_TEMPERATURE=<float>
# =============================================================================
# AGENT_RESUME_PROVIDER=openrouter
# AGENT_RESUME_MODEL=openrouter/free
# AGENT_MARKET_PROVIDER=openrouter
# AGENT_MARKET_MODEL=openrouter/free
# AGENT_LINKEDIN_PROVIDER=openrouter
# AGENT_LINKEDIN_MODEL=openrouter/free
# AGENT_ROADMAP_STRUCTURE_PROVIDER=groq
# AGENT_ROADMAP_STRUCTURE_MODEL=openai/gpt-oss-120b
# AGENT_ROADMAP_DETAILS_PROVIDER=groq
# AGENT_ROADMAP_DETAILS_MODEL=openai/gpt-oss-120b
# AGENT_INTERVIEW_PROVIDER=groq
# AGENT_INTERVIEW_MODEL=openai/gpt-oss-20b

# --- AUTH (JWT Secret) ---
SECRET_KEY=dev-secret-change-in-prod
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# --- Google OAuth (User Login with Google) ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# --- UPSTASH REDIS SETTINGS ---
# Optional: Set REDIS_URL for distributed rate limiting & metrics
# REDIS_URL=rediss://default:token@host.upstash.io:6379

# --- Search Engines (Professional APIs) ---
SERPER_API_KEY=your_serper_key_here
TAVILY_API_KEY=your_tavily_key_here
BING_SEARCH_API_KEY=your_bing_search_key_here

# --- Observability ---
ADMIN_EMAIL=anilpradhan9644@gmail.com
SENTRY_DSN=
ENABLE_OBSERVABILITY=true
CORS_ORIGINS=http://localhost:3000,https://ai-career-mentor.vercel.app,https://ai-career-mentor-anil.vercel.app