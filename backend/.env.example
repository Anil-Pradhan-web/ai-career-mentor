# ─────────────────────────────────────────────────────────────────────────────
# AI Career Mentor — Backend Environment Variables
# Copy this file to .env and fill in your real values.
# ⚠️  NEVER commit .env to GitHub!
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Configuration ────────────────────────────────────────────────────────
# Options: "groq" (Primary), "nvidia" (Fallback)
LLM_PROVIDER=groq

# ── Groq (FREE — No Credit Card!) ─────────────────────────────────────────────
# Get key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Google Gemini (Anya Voice Coach Only) ─────────────────────────────────────
# Get key from: https://aistudio.google.com/
# Note: Only used for Anya Voice Coach (Gemini Live Multimodal API)
GOOGLE_API_KEY=your_google_api_key_here

# ── Market Intelligence (Professional Search APIs) ────────────────────────────
# Get Serper Key from: https://serper.dev
SERPER_API_KEY=your_serper_api_key_here
# Get Tavily Key from: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# ── Database ──────────────────────────────────────────────────────────────────
# Use SQLite for local, Neon Postgres for production
DATABASE_URL=sqlite:///./dev.db

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_super_secret_jwt_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── Redis (Optional - for Rate Limiting) ──────────────────────────────────────
# Local Docker: redis://redis:6379/0
# Production: use your managed Redis URL, for example rediss://...
REDIS_URL=redis://localhost:6379/0

# ── App Environment ───────────────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,https://ai-career-mentor.vercel.app
