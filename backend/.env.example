# ─────────────────────────────────────────────────────────────────────────────
# AI Career Mentor — Backend Environment Variables
# Copy this file to .env and fill in your real values.
# ⚠️  NEVER commit .env to GitHub!
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Configuration ────────────────────────────────────────────────────────
# Options: "groq" (Free Dev), "google" (Production)
LLM_PROVIDER=groq

# ── Groq (FREE — No Credit Card!) ─────────────────────────────────────────────
# Get key from: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Google Gemini (via ag2 google library) ────────────────────────────────────
# Get key from: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-1.5-flash

# ── Database ──────────────────────────────────────────────────────────────────
# Use SQLite for local, Neon Postgres for production
DATABASE_URL=sqlite:///./dev.db

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_super_secret_jwt_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ── Redis (Optional - for Rate Limiting) ──────────────────────────────────────
# Get from: https://upstash.com
UPSTASH_REDIS_REST_URL=your_upstash_redis_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# ── App Environment ───────────────────────────────────────────────────────────
APP_ENV=development
CORS_ORIGINS=http://localhost:3000,https://ai-career-mentor.vercel.app
